---
import Base from '../layouts/Base.astro';

const title = '404 — Page not found';
const description = "The page you're looking for doesn't exist.";
---

<Base title={title} description={description} path="/404" noindex>
  <div class="container-880 py-16">
    <h1>404 — Page not found</h1>
    <p class="mt-3">The page you're looking for doesn't exist.</p>
    <p class="mt-6"><a href="/">Browse all tools →</a></p>
  </div>
</Base>
